{
  "name": "dsh-go-example-mic",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin example for the dsh-go app: the smallest usable microphone test — start/stop PCM capture, count frames, show the last seq and size (native plugin capability `mic`, protocol v1.4).",
  "author": "DSH-TUI (ccch1mneyyy)",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node ../../../sdk/plugin-kit/bin/check.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "麦克风测试",
      "en": "Mic test"
    },
    "icon": "mic",
    "capabilities": [
      "mic"
    ],
    "contributes": {
      "panels": [
        {
          "id": "mic",
          "title": {
            "zh": "麦克风",
            "en": "Microphone"
          }
        }
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  }
}
